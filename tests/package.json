{
  "name": "cat-priestess-print-checks",
  "private": true,
  "scripts": {
    "test": "node verify-print.cjs",
    "test:subscribe": "node --test subscribe.test.cjs",
    "test:unsubscribe": "node --test unsubscribe.test.cjs",
    "test:unsubscribe:redis": "node --test unsubscribe.redis.test.cjs",
    "build:pdf": "node verify-print.cjs && node publish-pdfs.cjs && python3 verify-downloads.py",
    "test:decks": "node verify-decks.cjs",
    "test:deck-source": "node verify-decks.cjs --source-only",
    "build:gothic-pdf": "python3 ../scripts/build-gothic-print.py && python3 ../scripts/build-gothic.py --ready && python3 ../scripts/render-gothic-print-preview.py && python3 verify-gothic-downloads.py",
    "test:gothic-print": "node verify-gothic-print.cjs && python3 verify-gothic-downloads.py",
    "test:companion": "python3 verify-companion.py"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.62.1"
  }
}
